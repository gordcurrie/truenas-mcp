# TrueNAS SCALE MCP Server — example environment configuration
# Copy this file to .env and fill in your values.
# Never commit .env — it is in .gitignore.

# Required: base URL of the TrueNAS SCALE API
TRUENAS_API_URL=https://truenas.local/api/v2.0

# Required: API key created in TrueNAS UI under Credentials → API Keys
TRUENAS_API_KEY=your-api-key-here

# Optional: set to "true" to skip TLS certificate verification (self-signed certs)
TRUENAS_INSECURE=false

# Optional: set to "true" to enable destructive tools (delete_dataset, delete_vm, etc.)
TRUENAS_ALLOW_DESTRUCTIVE=false
